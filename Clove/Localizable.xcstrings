    "Clove puts the skill in this project's .agents/skills folder and links it for each agent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clove puts the skill in this project's .agents/skills folder and links it for each agent."
