    "Each line becomes a Keychain lookup. A copy of the old profile goes to the Trash. New terminal windows pick up the change." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each line becomes a Keychain lookup. A copy of the old profile goes to the Trash. New terminal windows pick up the change."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行会改为查询钥匙串。旧配置文件的副本会移到废纸篓，新终端窗口会使用修改后的配置。"
          }
        },
