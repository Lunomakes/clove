          }
        }
      }
    },
    "The storage bar first, then anything that needs a look, like a permission Clove is missing or a disk that's nearly full." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The storage bar first, then anything that needs a look, like a permission Clove is missing or a disk that's nearly full."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先显示储存空间图表，再显示需要关注的事项，例如缺少权限或磁盘将满。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
