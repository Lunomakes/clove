          }
        }
      }
    },
    "The app each agent runs in, fanned out. Click one to open its chat, and hear about a task once, when it's actually done." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app each agent runs in, fanned out. Click one to open its chat, and hear about a task once, when it's actually done."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展开显示每个代理所在的应用。点按一个即可打开其对话；任务真正完成时只通知一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展開顯示每個代理所在的應用程式。按一下即可打開其對話；任務真正完成時只通知一次。"
          }
        }
      }
    },
    "The detail pane is easier to scan, with copyable references and cleaner file info." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The detail pane is easier to scan, with copyable references and cleaner file info."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "详情面板更便于浏览，引用可直接拷贝，文件信息更简洁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳情面板更便於瀏覽，引用可直接複製，檔案資訊更簡潔。"
          }
        }
      }
    },
    "The disk is nearly full" : {
      "localizations" : {
        "en" : {
