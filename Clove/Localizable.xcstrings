    "Hover the notch to peek at your agents, servers and storage. Move away and it closes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hover the notch to peek at your agents, servers and storage. Move away and it closes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将指针悬停在刘海上，即可预览代理、服务器和储存空间。移开即关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將指標懸停在瀏海上，即可預覽代理、伺服器和儲存空間。移開即關閉。"
          }
        }
      }
    },
    "Hover the notch to peek, click it or press the shortcut to search. Esc, a click elsewhere, or a click on the notch closes it. Right-click it for every section. Macs without a notch get one at the top of the menu bar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hover the notch to peek, click it or press the shortcut to search. Esc, a click elsewhere, or a click on the notch closes it. Right-click it for every section. Macs without a notch get one at the top of the menu bar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悬停在刘海上即可预览，点按或按下快捷键即可搜索。按 Esc、点按其他位置或再次点按刘海即可关闭。右键点按可查看所有分区。没有刘海的 Mac 会在菜单栏顶部显示一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "懸停在瀏海上即可預覽，按一下或按下快速鍵即可搜尋。按 Esc、按一下其他位置或再次按一下瀏海即可關閉。按右鍵可查看所有區塊。沒有瀏海的 Mac 會在選單列頂部顯示一個。"
          }
        }
      }
    },
    "Hover the top of the screen to peek at your agents, servers and storage. Move away and it closes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hover the top of the screen to peek at your agents, servers and storage. Move away and it closes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将指针悬停在屏幕顶部，即可预览代理、服务器和储存空间。移开即关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將指標懸停在螢幕頂部，即可預覽代理、伺服器和儲存空間。移開即關閉。"
          }
        }
      }
    },
    "Hover to peek, click to search. Grows for a moment when an agent finishes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hover to peek, click to search. Grows for a moment when an agent finishes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悬停预览，点按搜索。代理完成时会短暂展开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
