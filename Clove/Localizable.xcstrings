    "Each lane is a checkout of its own, often made by an agent. See where it split from the main branch, what's still unsaved, and which are safe to clear away." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each lane is a checkout of its own, often made by an agent. See where it split from the main branch, what's still unsaved, and which are safe to clear away."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条泳道都是一个独立的检出，通常由代理创建。查看它从主分支分出的位置、哪些尚未保存，以及哪些可以安全清理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每條泳道都是一個獨立的簽出，通常由代理建立。查看它從主分支分出的位置、哪些尚未儲存，以及哪些可以安全清理。"
          }
        }
      }
    },
    "Each line becomes a Keychain lookup. A copy of the old profile goes to the Trash. New terminal windows pick up the change." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each line becomes a Keychain lookup. A copy of the old profile goes to the Trash. New terminal windows pick up the change."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行会改为查询钥匙串。旧配置文件的副本会移到废纸篓，新终端窗口会使用修改后的配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行會改為查詢鑰匙圈。舊配置檔案的副本會移到垃圾桶，新終端視窗會使用修改後的配置。"
          }
        }
      }
    },
