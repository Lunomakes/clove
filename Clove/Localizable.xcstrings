    "Clove keeps the newest set for each kind of device. Xcode copies an older one again if you plug in a device still running it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clove keeps the newest set for each kind of device. Xcode copies an older one again if you plug in a device still running it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clove 会为每种设备保留最新的一组。如果你连接仍运行旧系统的设备，Xcode 会再次拷贝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clove 會為每種裝置保留最新的一組。如果你連接仍執行舊系統的裝置，Xcode 會再次複製。"
          }
        }
      }
    },
    "Clove links to this file instead of copying it, so changes show up for every agent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clove links to this file instead of copying it, so changes show up for every agent."
