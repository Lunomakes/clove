    "Claude Code, Codex, and Cursor keep %@ of session history on this Mac. %@ of it is from sessions older than %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex, and Cursor keep %@ of session history on this Mac. %@ of it is from sessions older than %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code、Codex 和 Cursor 在这台 Mac 上保存了 %1$@ 会话历史记录，其中 %2$@ 来自 %3$@之前的会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
