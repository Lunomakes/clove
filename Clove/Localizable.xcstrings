          }
        }
      }
    },
    "The version you run" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The version you run"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在使用的版本"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在使用的版本"
          }
        }
      }
    },
    "They go to the Trash first, so you can put them back from here until you empty it. Caches for open apps, for macOS, and folders you keep are left alone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They go to the Trash first, so you can put them back from here until you empty it. Caches for open apps, for macOS, and folders you keep are left alone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓存会先移到废纸篓。在清倒之前，可以从这里放回原处。不会改动正在运行的应用、macOS 或你保留的文件夹的缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快取會先移到垃圾桶。在清倒之前，可以從這裡放回原處。不會改動正在執行的應用程式、macOS 或你保留的檔案夾的快取。"
          }
        }
      }
    },
    "They take up %@ tokens in every agent session." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They take up %@ tokens in every agent session."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们在每次代理会话中占用 %@ 个 Token。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它們在每次代理會話中佔用 %@ 個 Token。"
          }
        }
      }
    },
    "They're deleted straight away. Apps rebuild them when they need them. Caches for open apps, for macOS, and folders you keep are left alone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They're deleted straight away. Apps rebuild them when they need them. Caches for open apps, for macOS, and folders you keep are left alone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓存将立即删除，应用需要时会重新生成。不会改动正在运行的应用、macOS 或你保留的文件夹的缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快取將立即刪除，應用程式需要時會重新生成。不會改動正在執行的應用程式、macOS 或你保留的檔案夾的快取。"
          }
        }
      }
    },
    "They're in your shell profile. Move them to the Keychain." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They're in your shell profile. Move them to the Keychain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些密钥位于 Shell 配置文件中。请将它们移到钥匙串。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些金鑰位於 Shell 配置檔案中。請將它們移到鑰匙圈。"
          }
        }
      }
    },
    "This Mac is activated. You can move the key to another Mac from Settings, About." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac is activated. You can move the key to another Mac from Settings, About."
