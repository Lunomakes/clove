    },
    "Closing the library keeps Clove in the menu bar. The Dock icon hides only while the library is closed, so Settings and shortcuts stay reachable when it's open." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closing the library keeps Clove in the menu bar. The Dock icon hides only while the library is closed, so Settings and shortcuts stay reachable when it's open."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭资料库后，Clove 继续在菜单栏运行。仅在资料库关闭时隐藏程序坞图标，打开时仍可访问设置和快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉資料庫後，Clove 繼續在選單列執行。僅在資料庫關閉時隱藏Dock圖示，開啟時仍可訪問設定和快速鍵。"
          }
        }
      }
    },
