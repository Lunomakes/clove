        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clove 会链接到此文件，所有代理都能读取到修改，无需拷贝文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clove 會連結到此檔案，所有代理都能讀取到修改，無需複製檔案。"
          }
        }
      }
    },
    "Clove needs Accessibility access to type into your editor." : {
